# Database credentials: created and rotated by RDS (manage_master_user_password = true in rds.tf).
# The secret ARN is aws_db_instance.this.master_user_secret[0].secret_arn and holds JSON {username, password}.
#
# The application consumes a single SQLAlchemy URL (ACH_DATABASE_URL), so we keep it in its own secret that
# the operator populates from the RDS-managed credentials (see README). For a fully passwordless setup, switch
# the app to RDS IAM auth tokens (iam_database_authentication_enabled = true is already set).

resource "aws_secretsmanager_secret" "database_url" {
  name                    = "${local.name}/ACH_DATABASE_URL"
  description             = "SQLAlchemy URL for the ACH backend (postgresql+psycopg://...?sslmode=require). Set by operator."
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = 30
}

resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id = aws_secretsmanager_secret.database_url.id
  secret_string = format(
    "postgresql+psycopg://%s:CHANGE_ME@%s:%d/%s?sslmode=require",
    var.db_username,
    aws_db_instance.this.address,
    aws_db_instance.this.port,
    var.db_name,
  )

  # The operator replaces the placeholder password; never overwrite their value.
  lifecycle {
    ignore_changes = [secret_string]
  }
}

# Fernet key for the account-number vault (ACH_VAULT_KEY). Terraform creates the secret with a placeholder
# that the app REJECTS at startup outside sandbox; the operator must set a real key before first deploy:
#   aws secretsmanager put-secret-value --secret-id <arn> --secret-string "$(python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
# The key is deliberately not generated by Terraform so it never lands in Terraform state.
resource "aws_secretsmanager_secret" "vault_key" {
  name                    = "${local.name}/ACH_VAULT_KEY"
  description             = "Fernet key for the ACH account-number vault. Losing it makes stored account numbers unrecoverable."
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = 30
}

resource "aws_secretsmanager_secret_version" "vault_key" {
  secret_id     = aws_secretsmanager_secret.vault_key.id
  secret_string = "q0dS2Z2wQ6pq7ZQd9qJ0b1QH9rWm3yJ8Rk4xT6uV2sA=" # sandbox default: startup fails until replaced

  lifecycle {
    ignore_changes = [secret_string]
  }
}
