# ACH platform configuration. Copy to .env and adjust.
# All settings are environment variables with the ACH_ prefix (see backend/app/config.py).
# Values below are SAFE SANDBOX DEFAULTS - never use them in production.

# Environment: sandbox | production. Production refuses to start with the default vault key
# and disables demo seeding.
ACH_ENV=sandbox

# SQLAlchemy URL. docker compose overrides this to point at the "db" service.
ACH_DATABASE_URL=postgresql+psycopg://ach:ach@localhost:5432/ach

# Fernet key used to encrypt account numbers at rest (the "vault").
# Mandatory and unique outside sandbox. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset in sandbox to use the built-in demo key. Losing this key makes stored
# account numbers unrecoverable - keep it in a secrets manager.
# ACH_VAULT_KEY=

# Institution identity (ODFI / RDFI) written into Nacha file headers.
ACH_BANK_NAME=Demo Community Bank
ACH_BANK_ROUTING=021000021
ACH_FED_ROUTING=011000015
ACH_FED_NAME=FEDERAL RESERVE BANK
ACH_RDFI_TIMEZONE=America/New_York

# Risk tuning
ACH_FRAUD_HOLD_SCORE=60
ACH_FRAUD_BLOCK_SCORE=90
ACH_OFAC_BLOCK_RATIO=0.92
ACH_OFAC_REVIEW_RATIO=0.85
ACH_LARGE_NEW_PAYEE_CENTS=1000000
ACH_STRUCTURING_THRESHOLD_CENTS=1000000
ACH_HIGH_RISK_COUNTRIES=IR,KP,SY,CU,RU,BY,MM

# Background scheduler: releases, settles and monitors every N seconds.
# Run it in exactly ONE process per environment (see the ECS "scheduler" service).
ACH_SCHEDULER_ENABLED=false
ACH_SCHEDULER_INTERVAL_SECONDS=60

# ITSM webhook (ServiceNow / PagerDuty / JSM) for incidents. Empty = disabled.
ACH_ITSM_WEBHOOK_URL=
ACH_WEBHOOK_MAX_ATTEMPTS=6

# Comma-separated browser origins allowed by CORS.
ACH_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Seed demo parties/payments/API keys at startup (sandbox only).
ACH_SEED_DEMO_DATA=true
